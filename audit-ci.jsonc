{
  // CI fails on any HIGH or CRITICAL advisory EXCEPT the ones listed below.
  // Every entry must have a reason and be re-checked when the dependency is upgraded.
  // Review date: 2026-11-16. Dependabot is enabled, so fixes arrive as pull requests.
  "high": true,
  "report-type": "summary",
  "allowlist": [
    // postcss (bundled inside next): the advisories need attacker-controlled CSS or source
    // maps. postcss only runs at build time on this repo's own globals.css, never on user
    // input. The real fix is next@16, a breaking upgrade that gets its own tested branch.
    // (GHSA-qx2v-qp2m-jg93 and GHSA-fxqj-rqcc-2cmp were removed: the audit reported them as
    // no longer present after `npm audit fix`.)
    "GHSA-6g55-p6wh-862q",
    "GHSA-r28c-9q8g-f849",

    // zod: memory exhaustion when validating oversized constrained collections (arrays,
    // sets, maps). No schema in this app accepts a collection from the client; every field
    // is a string or number, and server actions cap the request body at 100kb.
    // The real fix is zod@4, a breaking upgrade that gets its own tested branch.
    "GHSA-mrhx-c7xc-m3w5",

    // deepmerge-ts (inside the `prisma` CLI, a devDependency): stack exhaustion when merging
    // deeply recursive objects. It only runs on developer machines and at build time on this
    // repo's own Prisma config, never in the deployed app or on user input. The "fix" npm
    // suggests is downgrading only the CLI, which leaves it out of step with @prisma/client,
    // so both stay pinned to the same version instead. Real fix = Prisma 7 (major upgrade).
    "GHSA-ggr8-5vv4-36mx",

    // picomatch (inside eslint, typescript-eslint, fast-glob, tinyglobby: lint and build tooling
    // only): glob matching over this repo's own file paths at lint/build time. It never runs in
    // the deployed app or on user input. Added 2026-11-18 after a lockfile update did not clear
    // it; remove when the tooling ships a patched picomatch (check with `npm ls picomatch`).
    "GHSA-fc5q-39xc-vjpf",

    // effect (inside @prisma/config, which belongs to the `prisma` CLI, a devDependency): ReDoS
    // in Schema.TemplateLiteral decoding of untrusted input. Prisma uses it only to load this
    // repo's own prisma config on developer machines and in the build, never in the deployed app
    // and never on user input. Added 2026-11-20 when the advisory appeared; Prisma pins its own
    // effect version, so the real fix arrives with a Prisma update (Dependabot will open it).
    "GHSA-7589-6fvf-x4pw"
  ]
}
