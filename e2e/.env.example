# Copy to e2e/.env (never commit .env). These point the tests at STAGING.
# The Staging URL, with no trailing slash:
E2E_BASE_URL="https://your-staging-url.vercel.app"
# A dedicated test account created on Staging (2FA OFF for this account only):
E2E_USER_EMAIL="e2e-tester@example.com"
E2E_USER_PASSWORD="a-long-unique-password"
# Safety guard: comma-separated host names the tests must NEVER run against (your Production host):
E2E_BLOCK_HOSTS="your-production-domain.com"
# Only if Vercel "Deployment Protection" is on for Staging: Project > Settings > Deployment Protection >
# "Protection Bypass for Automation" gives you this secret.
VERCEL_BYPASS_SECRET=""
