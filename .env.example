# Neon pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Neon direct (non-pooled) connection string (used by prisma migrate only)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Generate with: openssl rand -base64 32   (min 32 chars, never reuse across environments)
BETTER_AUTH_SECRET="replace-with-32+-char-random-secret"
# Public origin of the app, no trailing slash
BETTER_AUTH_URL="http://localhost:3000"
