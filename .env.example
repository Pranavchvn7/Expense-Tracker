# LOCAL DEVELOPMENT: point these at your STAGING Neon database, never at production.
# `prisma migrate dev` changes whatever database these URLs point to.
#
# Neon pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Neon direct (non-pooled) connection string (used by prisma migrate only)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Generate with: openssl rand -base64 32   (min 32 chars, never reuse across environments)
BETTER_AUTH_SECRET="replace-with-32+-char-random-secret"
# Public origin of the app, no trailing slash
BETTER_AUTH_URL="http://localhost:3000"

# Registration switch. Set to false once you and your family have registered.
SIGNUPS_ENABLED="true"

# Set to "staging" ONLY on the staging deployment; it shows a red banner on every page.
# Leave unset (= production) everywhere else.
# APP_ENV="staging"

# OPTIONAL email (Resend, resend.com). Needs a verified sending domain.
# Leave both lines commented out to run without email: sign-up signs you in immediately,
# there is no email verification and no "forgot password" email.
# Set BOTH to turn email verification and password reset by email on.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Expense Tracker <no-reply@yourdomain.com>"

# OPTIONAL push notifications (budget alerts and renewal reminders).
# Generate once with:  npx web-push generate-vapid-keys
# Set all three, or leave all commented out. Use different keys for staging and production.
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:you@example.com"
# Protects the daily reminder job (/api/cron/reminders). Generate with: openssl rand -base64 32
# CRON_SECRET="replace-with-24+-char-random-secret"
