{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cle1"
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"staging\" ]",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "30 3 * * *"
    }
  ]
}
