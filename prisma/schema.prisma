generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Better Auth core tables ----------
// Verify against your installed version with: npx @better-auth/cli generate

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  twoFactorEnabled Boolean? @default(false)
  // Chosen once in Settings; used for every new expense, income and budget.
  currency      String    @default("INR") @db.VarChar(3)
  // Profile (nothing sensitive): ISO country code and IANA timezone. A null timezone means UTC.
  country       String?   @db.VarChar(2)
  timezone      String?   @db.VarChar(64)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  expenses      Expense[]
  categories    Category[]
  shares        SharedReport[]
  budgets       Budget[]
  incomes       Income[]
  recurringRules RecurringRule[]
  goals         SavingsGoal[]
  goalContributions GoalContribution[]
  twoFactor     TwoFactor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Authenticator-app 2FA (Better Auth twoFactor plugin). `secret` and `backupCodes` are
// stored encrypted by the plugin and are never selected by any app query.
model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Newer plugin versions track whether the first code was confirmed. Harmless if unused.
  verified    Boolean? @default(true)
  // Account lockout after repeated wrong codes (Better Auth 1.7+). Nullable with defaults
  // so the plugin can write or omit them.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("twoFactor")
}

// Better Auth's built-in DB-backed rate limiter storage
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------- App tables (every row is owned by a user) ----------

model Category {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(40)
  // Palette slot 1..7 shown on tags and charts; 0 = not assigned yet (filled in lazily).
  color     Int       @default(0)
  createdAt DateTime  @default(now())
  expenses  Expense[]
  budgets   Budget[]
  recurringRules RecurringRule[]

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Set when this row was generated by a recurring rule. (rule, date) is unique, so generating
  // the same occurrence twice (two tabs, a retry) is impossible.
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  // Money is stored as integer minor units (paise/cents) to avoid float errors.
  amountMinor Int
  currency    String    @db.VarChar(3) @default("INR")
  description String    @db.VarChar(120)
  note        String?   @db.VarChar(500)
  spentOn     DateTime  @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([recurringRuleId, spentOn])
  @@index([userId, spentOn])
  @@index([userId, categoryId])
}

// Money coming in (salary, refunds, gifts...). Same integer-minor-units rule as Expense.
model Income {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMinor Int
  currency    String   @db.VarChar(3) @default("INR")
  source      String   @db.VarChar(80)
  note        String?  @db.VarChar(500)
  receivedOn  DateTime @db.Date
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([recurringRuleId, receivedOn])
  @@index([userId, receivedOn])
}

enum RecurringKind {
  EXPENSE
  INCOME
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

// A repeating expense or income (rent, subscription, salary). Rows are generated on demand
// when the owner opens the app; nextDue is the first occurrence not generated yet.
model RecurringRule {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        RecurringKind
  amountMinor Int
  currency    String        @db.VarChar(3)
  label       String        @db.VarChar(80) // expense description or income source
  note        String?       @db.VarChar(500)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency   Frequency
  anchorDay   Int // day of month of the start date, so the 31st clamps to short months
  startDate   DateTime      @db.Date
  endDate     DateTime?     @db.Date
  nextDue     DateTime      @db.Date
  active      Boolean       @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expenses    Expense[]
  incomes     Income[]

  @@index([userId, active, nextDue])
}

// A savings target. Progress is the sum of its contributions (added by hand).
model SavingsGoal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(80)
  targetMinor   Int
  currency      String   @db.VarChar(3)
  targetDate    DateTime? @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amountMinor   Int
  contributedOn DateTime    @db.Date
  createdAt     DateTime    @default(now())

  @@index([userId, goalId])
}

// Monthly budget for one category in one currency (applies to every month).
model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amountMinor Int
  currency    String   @db.VarChar(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId, currency])
  @@index([userId])
}

// Opt-in, read-only monthly summary link. The id is an unguessable UUIDv4.
model SharedReport {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String   @db.VarChar(7) // YYYY-MM
  isPublic  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// App-level rate limiter for mutations (Better Auth limits its own endpoints)
model ActionLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
