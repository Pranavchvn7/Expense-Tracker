generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Better Auth core tables ----------
// Verify against your installed version with: npx @better-auth/cli generate

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  twoFactorEnabled Boolean? @default(false)
  // Chosen once in Settings; used for every new expense, income and budget.
  currency      String    @default("INR") @db.VarChar(3)
  // Profile (nothing sensitive): ISO country code and IANA timezone. A null timezone means UTC.
  country       String?   @db.VarChar(2)
  timezone      String?   @db.VarChar(64)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  expenses      Expense[]
  categories    Category[]
  shares        SharedReport[]
  budgets       Budget[]
  incomes       Income[]
  recurringRules RecurringRule[]
  goals         SavingsGoal[]
  goalContributions GoalContribution[]
  debts         Debt[]
  debtPayments  DebtPayment[]
  // Which push notifications this person wants (they still need to enable push on a device).
  notifyBudget   Boolean @default(true)
  notifyRenewals Boolean @default(true)
  notifyJobs     Boolean @default(true)
  pushSubscriptions PushSubscription[]
  // Freelance mode (v0.6): SALARIED is today's behaviour; FREELANCE and BOTH add Clients, Jobs and more.
  workMode      WorkMode  @default(SALARIED)
  clients       Client[]
  jobs          Job[]
  notificationLogs  NotificationLog[]
  twoFactor     TwoFactor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Authenticator-app 2FA (Better Auth twoFactor plugin). `secret` and `backupCodes` are
// stored encrypted by the plugin and are never selected by any app query.
model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Newer plugin versions track whether the first code was confirmed. Harmless if unused.
  verified    Boolean? @default(true)
  // Account lockout after repeated wrong codes (Better Auth 1.7+). Nullable with defaults
  // so the plugin can write or omit them.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("twoFactor")
}

// Better Auth's built-in DB-backed rate limiter storage
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------- App tables (every row is owned by a user) ----------

model Category {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(40)
  // Palette slot 1..7 shown on tags and charts; 0 = not assigned yet (filled in lazily).
  color     Int       @default(0)
  createdAt DateTime  @default(now())
  expenses  Expense[]
  budgets   Budget[]
  recurringRules RecurringRule[]

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Set when this row was generated by a recurring rule. (rule, date) is unique, so generating
  // the same occurrence twice (two tabs, a retry) is impossible.
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  // How it was paid, and whether it has been ticked off against a bank/card statement.
  paymentMethod PaymentMethod?
  reconciled    Boolean   @default(false)
  // Freelance: a cost of doing a job (travel, assistant, products). NoAction: a job with costs cannot be deleted.
  jobId         String?
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: NoAction)
  costKind      JobCostKind?
  payee         String?   @db.VarChar(80)
  // Random id made on the device when an entry was added offline, so a retried sync can never
  // create it twice. Null for entries added normally.
  clientRef     String?   @db.VarChar(36)
  // Money is stored as integer minor units (paise/cents) to avoid float errors.
  amountMinor Int
  currency    String    @db.VarChar(3) @default("INR")
  description String    @db.VarChar(120)
  note        String?   @db.VarChar(500)
  spentOn     DateTime  @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([recurringRuleId, spentOn])
  @@index([userId, spentOn])
  @@index([userId, categoryId])
  @@index([userId, paymentMethod, spentOn])
  @@index([userId, jobId])
  @@unique([userId, clientRef])
}

enum JobCostKind {
  TRAVEL
  ASSISTANT
  PRODUCTS
  OTHER
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  BANK_TRANSFER
  WALLET
  OTHER
}

// Money coming in (salary, refunds, gifts...). Same integer-minor-units rule as Expense.
model Income {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMinor Int
  currency    String   @db.VarChar(3) @default("INR")
  source      String   @db.VarChar(80)
  note        String?  @db.VarChar(500)
  receivedOn  DateTime @db.Date
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientRef   String?  @db.VarChar(36)

  // Freelance: a payment received for a job. NoAction so a job with payments cannot be deleted
  // (account deletion still cascades because every row is removed in the same statement).
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: NoAction)
  paymentKind PaymentKind?

  @@unique([recurringRuleId, receivedOn])
  @@unique([userId, clientRef])
  @@index([userId, receivedOn])
  @@index([userId, jobId])
}

enum PaymentKind {
  ADVANCE
  PARTIAL
  FINAL
}

enum RecurringKind {
  EXPENSE
  INCOME
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

// A repeating expense or income (rent, subscription, salary). Rows are generated on demand
// when the owner opens the app; nextDue is the first occurrence not generated yet.
model RecurringRule {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        RecurringKind
  amountMinor Int
  currency    String        @db.VarChar(3)
  label       String        @db.VarChar(80) // expense description or income source
  note        String?       @db.VarChar(500)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency   Frequency
  anchorDay   Int // day of month of the start date, so the 31st clamps to short months
  startDate   DateTime      @db.Date
  endDate     DateTime?     @db.Date
  nextDue     DateTime      @db.Date
  active      Boolean       @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expenses    Expense[]
  incomes     Income[]

  @@index([userId, active, nextDue])
}

// A savings target. Progress is the sum of its contributions (added by hand).
model SavingsGoal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(80)
  targetMinor   Int
  currency      String   @db.VarChar(3)
  targetDate    DateTime? @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amountMinor   Int
  contributedOn DateTime    @db.Date
  createdAt     DateTime    @default(now())

  @@index([userId, goalId])
}

enum DebtKind {
  CREDIT_CARD
  LOAN
}

// A loan or credit card balance being paid down. The balance is never stored: it is replayed
// from the payments, so back-dated entries and deletions cannot leave stale numbers.
model Debt {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String        @db.VarChar(80)
  kind            DebtKind
  currency        String        @db.VarChar(3)
  originalMinor   Int // amount owed on startDate
  aprBp           Int // yearly interest in basis points (1250 = 12.50%)
  minPaymentMinor Int // usual monthly payment / EMI
  startDate       DateTime      @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payments        DebtPayment[]

  @@index([userId])
}

model DebtPayment {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtId               String
  debt                 Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  paidOn               DateTime @db.Date
  amountMinor          Int
  // Optional: the exact interest from the statement. Empty means it is worked out from the rate.
  interestOverrideMinor Int?
  note                 String?  @db.VarChar(200)
  createdAt            DateTime @default(now())

  @@index([userId, debtId, paidOn])
}

// One browser or phone that agreed to receive push notifications for a user. The endpoint is
// the push service's address for that device; p256dh and auth are the keys the payload is
// encrypted with. They are secrets of the subscription and never leave the server.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique @db.VarChar(1000)
  p256dh     String   @db.VarChar(100)
  auth       String   @db.VarChar(30)
  userAgent  String?  @db.VarChar(200)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Remembers which alerts were already sent so each one goes out once
// (budget80:<budgetId>:<month>, renewal:<ruleId>:<date>, ...).
model NotificationLog {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key     String   @db.VarChar(120)
  sentAt  DateTime @default(now())

  @@unique([userId, key])
  @@index([sentAt])
}

// Monthly budget for one category in one currency (applies to every month).
model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amountMinor Int
  currency    String   @db.VarChar(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId, currency])
  @@index([userId])
}

// Opt-in, read-only monthly summary link. The id is an unguessable UUIDv4.
model SharedReport {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String   @db.VarChar(7) // YYYY-MM
  isPublic  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// App-level rate limiter for mutations (Better Auth limits its own endpoints)
model ActionLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

enum WorkMode {
  SALARIED
  FREELANCE
  BOTH
}

// A person or business the user works for (a bride, a studio...). Personal data: every query is
// scoped by userId. Jobs will link to a client in a later release.
model Client {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(254)
  city      String?  @db.VarChar(80)
  address   String?  @db.VarChar(200)
  source    String?  @db.VarChar(60) // how they found you: Instagram, referral...
  notes     String?  @db.VarChar(1000)
  archived  Boolean  @default(false)
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archived, name])
  @@index([userId, createdAt])
}

enum JobStatus {
  ENQUIRY
  BOOKED
  COMPLETED
  CANCELLED
}

// One piece of work for a client (a bridal booking, a shoot...). Payments and job costs will link
// here through the existing Income and Expense tables in a later release.
model Job {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String
  // NoAction (not Cascade): a client with jobs cannot be deleted by accident. Deleting the whole
  // account still works because jobs and clients are both removed by the user cascade.
  client            Client    @relation(fields: [clientId], references: [id], onDelete: NoAction)
  title             String    @db.VarChar(100)
  serviceType       String?   @db.VarChar(60)
  eventDate         DateTime  @db.Date
  startTime         String?   @db.VarChar(5) // "HH:MM", local time of the job
  endTime           String?   @db.VarChar(5)
  location          String?   @db.VarChar(200)
  status            JobStatus @default(BOOKED)
  agreedAmountMinor Int       @default(0) // the price agreed with the client; 0 = not agreed yet
  currency          String    @db.VarChar(3)
  notes             String?   @db.VarChar(1000)
  payments          Income[]
  costs             Expense[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, eventDate])
  @@index([userId, clientId])
  @@index([userId, status, eventDate])
}
